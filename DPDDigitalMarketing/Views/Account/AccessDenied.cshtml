@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="modern-card p-5 mx-auto" style="max-width: 500px;">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
        </div>
        <h3 class="fw-bold font-display">Access Restricted</h3>
        <p class="text-muted">You do not have permission to view this resource. Please sign in with an Administrator account.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-ink mt-2">Back to Home</a>
    </div>
</div>
