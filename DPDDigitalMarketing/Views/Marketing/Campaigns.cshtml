@model IEnumerable<DPDDigitalMarketing.Models.Campaign>
@{
    ViewData["Title"] = "Marketing Campaigns & ROI";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Marketing Campaigns & ROI Tracking</h2>
        <p class="text-muted">Track cost-effectiveness across SEO, Email, Social Media, and Marketplace ads.</p>
    </div>
    <a asp-action="CreateCampaign" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Campaign
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Campaign</th>
                        <th>Marketing Channel</th>
                        <th>Spend / Budget</th>
                        <th>Revenue</th>
                        <th>Clicks</th>
                        <th>Conversions</th>
                        <th>ROI (%)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold">@c.CampaignName</td>
                            <td><span class="badge bg-secondary">@c.Channel</span></td>
                            <td>₹@c.Cost.ToString("N0")</td>
                            <td class="text-success fw-bold">₹@c.RevenueGenerated.ToString("N0")</td>
                            <td>@c.Clicks</td>
                            <td>@c.Conversions sales</td>
                            <td>
                                <span class="badge @(c.ROI > 0 ? "bg-success" : "bg-danger")">
                                    @(c.ROI > 0 ? "+" : "")@c.ROI.ToString("F1")%
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@c.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
