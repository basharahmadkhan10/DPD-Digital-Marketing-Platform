@model IEnumerable<DPDDigitalMarketing.Models.Order>
@{
    ViewData["Title"] = "Multi-Channel Sales Orders";
}

<div class="container py-4">
    <!-- Header with clean padding & margins -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="badge-pill-orange mb-1 d-inline-block">ORDER MANAGEMENT</span>
            <h2 class="fw-bold font-display mb-0">Sales Orders & Channel Tracking</h2>
            <p class="text-muted small">Comprehensive audit log of direct website sales and outbound marketplace referral leads.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                <form asp-action="ClearAllOrders" method="post" onsubmit="return confirm('Kya aap saare test orders aur referrals empty karna chahte hain?');" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm py-2 px-3" title="Empty all orders from database">
                        <i class="bi bi-trash3 me-1"></i> Empty / Reset Orders
                    </button>
                </form>
                <a asp-controller="Marketing" asp-action="Dashboard" class="btn btn-ink btn-sm py-2 px-3">
                    <i class="bi bi-bar-chart-fill me-1"></i> View Analytics
                </a>
            </div>
        }
    </div>

    <!-- Orders Table inside clean modern card -->
    <div class="modern-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="rounded-start">Order ID</th>
                        <th>Customer</th>
                        <th>Sale Channel</th>
                        <th>Publications Purchased</th>
                        <th>Amount</th>
                        <th>Date & Time</th>
                        <th class="rounded-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-2 d-block mb-2 text-secondary"></i>
                                No orders or referrals recorded yet.
                            </td>
                        </tr>
                    }
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#DPD-@order.Id</td>
                            <td>
                                <div class="fw-semibold">@order.CustomerName</div>
                                <small class="text-muted">@order.CustomerEmail</small>
                            </td>
                            <td>
                                @if (order.SaleChannel == "Amazon")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold"><i class="bi bi-shop me-1"></i> Amazon</span>
                                }
                                else if (order.SaleChannel == "Flipkart")
                                {
                                    <span class="badge bg-info text-white rounded-pill px-3 py-1 fw-bold"><i class="bi bi-box me-1"></i> Flipkart</span>
                                }
                                else if (order.SaleChannel.StartsWith("Social"))
                                {
                                    <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold"><i class="bi bi-share me-1"></i> Social Media</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-1 fw-bold"><i class="bi bi-globe me-1"></i> Official Website</span>
                                }
                            </td>
                            <td>
                                @foreach (var item in order.OrderItems)
                                {
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                        <span class="small fw-semibold">@(item.Product?.Title ?? "Publication") <span class="text-muted fw-normal">(×@item.Quantity)</span></span>
                                        @if (item.ProductId > 0)
                                        {
                                            <a asp-controller="Library" asp-action="Read" asp-route-id="@item.ProductId" class="btn btn-pill-outline btn-sm rounded-pill px-2 py-0 text-nowrap" style="font-size: 0.72rem;" title="Read Online">
                                                <i class="bi bi-book-half me-1"></i> Read Online
                                            </a>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (order.Status == "Completed")
                                {
                                    <span class="fw-bold text-success fs-6">₹@order.TotalAmount</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border rounded-pill">Referral Click (₹0)</span>
                                }
                            </td>
                            <td class="text-muted small">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                @if (order.Status == "Completed")
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Paid / Direct Sale</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-box-arrow-up-right me-1"></i> Marketplace Lead</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
