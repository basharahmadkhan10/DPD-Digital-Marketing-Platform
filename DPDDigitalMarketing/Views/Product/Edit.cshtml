@model DPDDigitalMarketing.Models.Product
@{
    ViewData["Title"] = "Edit Publication";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold">Edit Publication #@Model.Id</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label fw-semibold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="EmploymentNews">Employment News</option>
                                <option value="Journal">Journal</option>
                                <option value="Book">Book</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Language" class="form-label fw-semibold">Language</label>
                            <input asp-for="Language" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">Price (₹)</label>
                            <input asp-for="Price" type="number" step="0.5" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CoverImageUrl" class="form-label fw-semibold">Cover Image URL</label>
                            <input asp-for="CoverImageUrl" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold">Stock Quantity</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AmazonUrl" class="form-label fw-semibold">Amazon India URL</label>
                            <input asp-for="AmazonUrl" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FlipkartUrl" class="form-label fw-semibold">Flipkart URL</label>
                            <input asp-for="FlipkartUrl" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active & Visible in Catalog</label>
                    </div>

                    <div class="d-flex gap-2 justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-danger" onclick="document.getElementById('deleteForm').submit();">Archive Issue</button>
                        <div>
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </div>
                </form>

                <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
</div>
